# WBMM real-robot deployment environment.
#
# This file is sourced by deploy/build.sh, deploy/start.sh and
# deploy/poweroff.sh. Override any value from the shell if needed.

# Workspace root. Defaults to the repository that contains deploy/.
WBMM_WS="${WBMM_WS:-$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)}"

# ROS environment.
ROS_DISTRO="${ROS_DISTRO:-humble}"
ROS_DOMAIN_ID="${ROS_DOMAIN_ID:-0}"
RMW_IMPLEMENTATION="${RMW_IMPLEMENTATION:-rmw_fastrtps_cpp}"

# JAKA network configuration.
JAKA_IP="${JAKA_IP:-10.5.5.100}"
JAKA_LOCAL_IP="${JAKA_LOCAL_IP:-10.5.5.127}"

# Tracer CAN configuration.
CAN_IFACE="${CAN_IFACE:-can0}"
CAN_BITRATE="${CAN_BITRATE:-500000}"
CAN_SETUP_MODULE="${CAN_SETUP_MODULE:-gs_usb}"
CAN_LOAD_MODULE="${CAN_LOAD_MODULE:-true}"
CAN_UNLOAD_MODULE="${CAN_UNLOAD_MODULE:-false}"

# Build configuration.
WBMM_BUILD_TYPE="${WBMM_BUILD_TYPE:-Release}"
WBMM_BUILD_PACKAGES="${WBMM_BUILD_PACKAGES:-tracer_jaka_bringup tracer_jaka_description tracer_jaka_localization tracer_jaka_mujoco wbmm_core wbmm_pinocchio wbmm_ros_interfaces wbmm_ocs2 wbmm_ocs2_ros whole_body_force_control jaka_sdk_vendor jaka_hardware_interface jaka_driver tracer_msgs ugv_sdk tracer_base hipnuc_lib_package hipnuc_imu lakibeam1}"

# Deployment metadata/log locations.
WBMM_LOG_DIR="${WBMM_LOG_DIR:-${WBMM_WS}/deploy/logs}"
WBMM_METADATA_DIR="${WBMM_METADATA_DIR:-${WBMM_WS}/deploy/metadata}"

export WBMM_WS ROS_DISTRO ROS_DOMAIN_ID RMW_IMPLEMENTATION
export JAKA_IP JAKA_LOCAL_IP
export CAN_IFACE CAN_BITRATE CAN_SETUP_MODULE CAN_LOAD_MODULE CAN_UNLOAD_MODULE
export WBMM_BUILD_TYPE WBMM_BUILD_PACKAGES WBMM_LOG_DIR WBMM_METADATA_DIR
