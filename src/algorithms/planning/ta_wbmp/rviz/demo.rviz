Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Alpha: 0.5
      Cell Size: 1
      Color: 160; 160; 164
      Line Style:
        Line Width: 0.03
        Value: Lines
      Plane: XY
      Plane Cell Count: 1000
      Reference Frame: <Fixed Frame>
      Value: true
    - Class: rviz_common/Group
      Displays:
        - Class: rviz_default_plugins/MarkerArray
          Enabled: true
          Name: Robot Mesh
          Namespaces:
            current_robot: true
          Topic:
            Depth: 5
            Durability Policy: Transient Local
            History Policy: Keep Last
            Reliability Policy: Reliable
            Value: /wbmm/robot_mesh
          Value: true
        - Class: rviz_common/Group
          Displays:
            - Class: rviz_default_plugins/MarkerArray
              Enabled: true
              Name: Task Constraints
              Namespaces: {}
              Topic:
                Depth: 5
                Durability Policy: Transient Local
                History Policy: Keep Last
                Reliability Policy: Reliable
                Value: /ta_wbmp/markers
              Value: true
            - Class: rviz_default_plugins/MarkerArray
              Enabled: true
              Name: "[Car&Mani] Time Segment Mesh"
              Namespaces: {}
              Topic:
                Depth: 5
                Durability Policy: Transient Local
                History Policy: Keep Last
                Reliability Policy: Reliable
                Value: /wbmm/time_segments
              Value: true
            - Class: rviz_default_plugins/MarkerArray
              Enabled: true
              Name: Time Playback
              Namespaces: {}
              Topic:
                Depth: 5
                Durability Policy: Transient Local
                History Policy: Keep Last
                Reliability Policy: Reliable
                Value: /wbmm/playback
              Value: true
          Enabled: true
          Name: Planning
      Enabled: true
      Name: mm
  Enabled: true
  Global Options:
    Background Color: 255; 255; 255
    Fixed Frame: world
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
      Hide Inactive Objects: true
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
    - Class: rviz_default_plugins/Measure
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 5.2
      Focal Point:
        X: 1.5
        Y: 1.7
        Z: 0.55
      Pitch: 0.48
      Yaw: 4.05
Window Geometry:
  Height: 900
  Width: 1400
