    [16] "Link_0, tool0_and_camera_link"
    [17] "Link_1, tool0_and_camera_link"
    [18] "Link_2, tool0_and_camera_link"
    [19] "Link_3, tool0_and_camera_link"
    [20] "Link_4, tool0_and_camera_link"
    [21] "Link_5, tool0_and_camera_link"

