    [0]  "base_link, Link_2"
    [1]  "base_link, Link_3"
    [2]  "base_link, Link_4"
    [3]  "base_link, Link_5"
    [4]  "base_link, Link_6"
    [5]  "base_link, tool0_and_camera_link"
    [6]  "base_link, d435i_link"

    ; 非相邻机械臂 link
    [7]  "Link_0, Link_2"
    [8]  "Link_0, Link_3"
    [9]  "Link_1, Link_3"
    [10] "Link_1, Link_4"
    [11] "Link_2, Link_4"
    [12] "Link_2, Link_5"
    [13] "Link_3, Link_5"
    [14] "Link_3, Link_6"
    [15] "Link_4, Link_6"

