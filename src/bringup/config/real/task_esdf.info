environmentCollision
{
  backend esdf
  esdf
  {
    frame "odom"
  }

  activate            true

  mu                  1e-3
  delta               1e-3
  minimumDistance     0.05    ; 期望最小间隙 [m]
  activationDistance  0.20  ; 距离 < 此值才开始惩罚 [m] (缺省=5*minimumDistance)

  collisionLinks
  {
    [0] "base_link"
    [1] "Link_3"
    [2] "Link_4"
    [3] "Link_5"
    [4] "Link_6"
    [5] "tool0_and_camera_link"
    [6] "d435i_link"
  }

}

