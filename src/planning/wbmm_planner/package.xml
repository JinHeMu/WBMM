<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>wbmm_planner</name>
  <version>0.1.0</version>
  <description>
    ROS-free whole-body planner with base search, arm seeding, MINCO trajectory
    optimization and orchestration.
    Replaces the REMANI plan_manage orchestration.
  </description>
  <maintainer email="user@todo.todo">WBMM</maintainer>
  <license>BSD-3-Clause</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>eigen</depend>
  <depend>wbmm_core</depend>
  <depend>wbmm_environment</depend>
  <depend>wbmm_collision</depend>
  <depend>wbmm_robot_model</depend>
  <exec_depend>python3-matplotlib</exec_depend>

  <test_depend>ament_cmake_gtest</test_depend>
  <test_depend>wbmm_pinocchio</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
