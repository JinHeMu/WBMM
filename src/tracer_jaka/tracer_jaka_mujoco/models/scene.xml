<mujoco model="tracer_jaka_zu5_scene">

  <compiler angle="radian"
            meshdir="/home/a/mujoco_sim/tracer_jaka_zu5/tracer_jaka_zu5_mjcf/tracer_jaka_zu5/meshes" />

  <include file="tracer_jaka_zu5_robot.xml"/>

  <asset>
    <texture name="groundplane" type="2d" builtin="checker" mark="edge"
             rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3" markrgb="0.8 0.8 0.8"
             width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texrepeat="4 4"
              texuniform="true" reflectance="0.2"/>
  </asset>

  <worldbody>
    <light name="top" pos="0 0 4" dir="0 0 -1" diffuse="0.7 0.7 0.7" />

    <geom name="floor"
          type="plane"
          size="8 8 0.05"
          pos="0 0 0"
          material="groundplane"
          contype="1"
          conaffinity="1"
          condim="3"
          friction="2.0 0.01 0.001" />

    <!-- 四周墙体 — 5m×5m 活动区域 -->
    <body name="wall_n" pos="0 2.5 0.5">
      <geom type="box" size="2.5 0.05 0.5" contype="1" conaffinity="1"
            rgba="0.8 0.8 0.78 1"/>
    </body>
    <body name="wall_s" pos="0 -2.5 0.5">
      <geom type="box" size="2.5 0.05 0.5" contype="1" conaffinity="1"
            rgba="0.8 0.8 0.78 1"/>
    </body>
    <body name="wall_e" pos="2.5 0 0.5">
      <geom type="box" size="0.05 2.5 0.5" contype="1" conaffinity="1"
            rgba="0.8 0.8 0.78 1"/>
    </body>
    <body name="wall_w" pos="-2.5 0 0.5">
      <geom type="box" size="0.05 2.5 0.5" contype="1" conaffinity="1"
            rgba="0.8 0.8 0.78 1"/>
    </body>

    <!-- ==================================================================== -->
    <!-- 低桌穿越场景                                                         -->
    <!--                                                                      -->
    <!-- 机器人碰撞包络（由 URDF + Pinocchio 计算）:                          -->
    <!--   base: 0.74 x 0.68 x 0.39 m                                        -->
    <!--   arm home height: 1.52 m                                            -->
    <!--   arm low  height: 1.00 m                                            -->
    <!--                                                                      -->
    <!-- 桌面下沿 1.10 m: home 必须折叠，low 加 0.05 m 安全距离后可通过。       -->
    <!-- 桌面横跨房间，不能从两侧绕过；四条腿保留 1.34 m 的中央通道。           -->
    <!-- map->odom: x_odom = x_mujoco + 2.0，桌面中心位于 odom x=2.0。          -->
    <!-- ==================================================================== -->

    <body name="low_table" pos="0 0 0">
      <!-- 1.70 m 行进方向长度，4.70 m 横向宽度，桌面厚 0.10 m。 -->
      <geom name="low_table_top"
            type="box"
            pos="0 0 1.15"
            size="0.85 2.35 0.05"
            contype="1"
            conaffinity="1"
            friction="1.2 0.01 0.001"
            rgba="0.58 0.34 0.16 1"/>

      <!-- 桌腿: 0.16 x 0.16 m，高度 1.10 m。 -->
      <geom name="low_table_leg_front_left"
            type="box"
            pos="-0.68 0.75 0.55"
            size="0.08 0.08 0.55"
            contype="1"
            conaffinity="1"
            rgba="0.20 0.22 0.24 1"/>
      <geom name="low_table_leg_front_right"
            type="box"
            pos="-0.68 -0.75 0.55"
            size="0.08 0.08 0.55"
            contype="1"
            conaffinity="1"
            rgba="0.20 0.22 0.24 1"/>
      <geom name="low_table_leg_rear_left"
            type="box"
            pos="0.68 0.75 0.55"
            size="0.08 0.08 0.55"
            contype="1"
            conaffinity="1"
            rgba="0.20 0.22 0.24 1"/>
      <geom name="low_table_leg_rear_right"
            type="box"
            pos="0.68 -0.75 0.55"
            size="0.08 0.08 0.55"
            contype="1"
            conaffinity="1"
            rgba="0.20 0.22 0.24 1"/>
    </body>

  </worldbody>
</mujoco>
