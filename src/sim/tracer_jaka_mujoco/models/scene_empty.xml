<mujoco model="tracer_jaka_zu5_empty_scene">

  <compiler angle="radian" meshdir="meshes" />

  <!-- Minimal commissioning scene: robot, ground plane and light only. -->
  <include file="tracer_jaka_zu5_robot.xml"/>

  <asset>
    <texture name="empty_scene_ground" type="2d" builtin="checker" mark="edge"
             rgb1="0.20 0.25 0.30" rgb2="0.12 0.15 0.18"
             markrgb="0.70 0.70 0.70" width="300" height="300"/>
    <material name="empty_scene_ground" texture="empty_scene_ground"
              texrepeat="8 8" texuniform="true" reflectance="0.15"/>
  </asset>

  <worldbody>
    <light name="top" pos="0 0 6" dir="0 0 -1"
           diffuse="0.75 0.75 0.75"/>

    <geom name="floor" type="plane" size="8 8 0.05" pos="0 0 0"
          material="empty_scene_ground" contype="1" conaffinity="1"
          condim="3" friction="2.0 0.01 0.001"/>
  </worldbody>
</mujoco>
