Panels:
  - Class: rviz_common/Displays
    Help Height: 0
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /mm1
        - /mm1/mm_vis1
        - /mm1/Planning1
        - /mm1/Planning1/start&goal1
        - /mm1/Planning1/[Car&Mani] Front End Mesh1
        - /mm1/Planning1/simulation_map1/Autocompute Value Bounds1
      Splitter Ratio: 0.5498241782188416
    Tree Height: 775
  - Class: rviz_common/Selection
    Name: Selection
  - Class: rviz_common/Tool Properties
    Expanded:
      - /2D Pose Estimate1
      - /Publish Point1
    Name: Tool Properties
    Splitter Ratio: 0.5886790156364441
  - Class: rviz_common/Time
    Experimental: false
    Name: Time
    SyncMode: 0
    SyncSource: simulation_map
  - Class: rviz_common/Views
    Expanded:
      - /Current View1
    Name: Views
    Splitter Ratio: 0.5
  - Class: rviz_common/Views
    Expanded:
      - /Current View1
    Name: Views
    Splitter Ratio: 0.5
Visualization Manager:
  Class: ""
  Displays:
    - Alpha: 0.5
      Cell Size: 1
      Class: rviz_default_plugins/Grid
      Color: 160; 160; 164
      Enabled: true
      Line Style:
        Line Width: 0.029999999329447746
        Value: Lines
      Name: Grid
      Normal Cell Count: 0
      Offset:
        X: 0
        Y: 0
        Z: 0
      Plane: XY
      Plane Cell Count: 1000
      Reference Frame: <Fixed Frame>
      Value: true
    - Class: rviz_common/Group
      Displays:
        - Class: rviz_default_plugins/MarkerArray
          Enabled: true
          Name: mm_vis
          Namespaces:
            vis_mm_odom: true
          Topic:
            Depth: 5
            Durability Policy: Transient Local
            History Policy: Keep Last
            Reliability Policy: Reliable
            Value: /model_vis/vis_mm
          Value: true
        - Class: rviz_common/Group
          Displays:
            - Class: rviz_default_plugins/MarkerArray
              Enabled: true
              Name: start&goal
              Namespaces:
                {}
              Topic:
                Depth: 5
                Durability Policy: Volatile
                Filter size: 10
                History Policy: Keep Last
                Reliability Policy: Reliable
                Value: /kinoastar/local_start_goal
              Value: true
            - Class: rviz_default_plugins/MarkerArray
              Enabled: true
              Name: "[Car&Mani] Front End Mesh"
              Namespaces:
                {}
              Topic:
                Depth: 5
                Durability Policy: Volatile
                History Policy: Keep Last
                Reliability Policy: Reliable
                Value: /front_end_mm_mesh_vis
              Value: true
            - Class: rviz_default_plugins/MarkerArray
              Enabled: true
              Name: "[Car&Mani] Back End Mesh"
              Namespaces:
                {}
              Topic:
                Depth: 5
                Durability Policy: Volatile
                History Policy: Keep Last
                Reliability Policy: Reliable
                Value: /back_end_mm_mesh_vis
              Value: true
            - Class: rviz_default_plugins/Marker
              Enabled: true
              Name: Global Trajectory
              Namespaces:
                {}
              Topic:
                Depth: 5
                Durability Policy: Volatile
                Filter size: 10
                History Policy: Keep Last
                Reliability Policy: Reliable
                Value: /global_traj
              Value: true
            - Class: rviz_default_plugins/Marker
              Enabled: true
              Name: Kinodynamic AStar Path
              Namespaces:
                {}
              Topic:
                Depth: 5
                Durability Policy: Volatile
                Filter size: 10
                History Policy: Keep Last
                Reliability Policy: Reliable
                Value: /kinoastar/path
              Value: true
            - Class: rviz_default_plugins/Marker
              Enabled: true
              Name: Optimized Control Points
              Namespaces:
                {}
              Topic:
                Depth: 5
                Durability Policy: Volatile
                Filter size: 10
                History Policy: Keep Last
                Reliability Policy: Reliable
                Value: /optimal_ctrl_pts
              Value: true
            - Alpha: 1
              Autocompute Intensity Bounds: true
              Autocompute Value Bounds:
                Max Value: 2.9000000953674316
                Min Value: 0
                Value: false
              Axis: Z
              Channel Name: intensity
              Class: rviz_default_plugins/PointCloud2
              Color: 164; 0; 0
              Color Transformer: AxisColor
              Decay Time: 0
              Enabled: true
              Invert Rainbow: false
              Max Color: 255; 255; 255
              Max Intensity: 4096
              Min Color: 0; 0; 0
              Min Intensity: 0
              Name: simulation_map
              Position Transformer: XYZ
              Selectable: true
              Size (Pixels): 1.2999999523162842
              Size (m): 0.019999999552965164
              Style: Squares
              Topic:
                Depth: 5
                Durability Policy: Volatile
                Filter size: 10
                History Policy: Keep Last
                Reliability Policy: Reliable
                Value: /map_generator/global_cloud
              Use Fixed Frame: true
              Use rainbow: true
              Value: true
          Enabled: true
          Name: Planning
      Enabled: true
      Name: mm
  Enabled: true
  Global Options:
    Background Color: 255; 255; 255
    Fixed Frame: world
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
      Hide Inactive Objects: true
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
    - Class: rviz_default_plugins/Measure
      Line color: 128; 128; 0
    - Class: rviz_default_plugins/SetInitialPose
      Covariance x: 0.25
      Covariance y: 0.25
      Covariance yaw: 0.06853891909122467
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /initialpose
    - Class: rviz_default_plugins/SetGoal
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /move_base_simple/goal
    - Class: rviz_default_plugins/PublishPoint
      Single click: true
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /clicked_point
    - Class: rviz_plugins/Goal3DTool
      Topic: goal
  Transformation:
    Current:
      Class: rviz_default_plugins/TF
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 9.180548667907715
      Enable Stereo Rendering:
        Stereo Eye Separation: 0.05999999865889549
        Stereo Focal Distance: 1
        Swap Stereo Eyes: false
        Value: false
      Focal Point:
        X: 0.20248211920261383
        Y: -0.33940109610557556
        Z: -0.7389836311340332
      Focal Shape Fixed Size: false
      Focal Shape Size: 0.05000000074505806
      Invert Z Axis: false
      Name: Current View
      Near Clip Distance: 0.009999999776482582
      Pitch: 0.649796724319458
      Target Frame: world
      Value: Orbit (rviz_default_plugins)
      Yaw: 3.8069138526916504
    Saved:
      - Class: rviz_default_plugins/FPS
        Enable Stereo Rendering:
          Stereo Eye Separation: 0.05999999865889549
          Stereo Focal Distance: 1
          Swap Stereo Eyes: false
          Value: false
        Invert Z Axis: false
        Name: FPS
        Near Clip Distance: 0.009999999776482582
        Pitch: 0.4000000059604645
        Position:
          X: -11
          Y: 0
          Z: 8
        Target Frame: my_view
        Value: FPS (rviz_default_plugins)
        Yaw: 0
      - Class: rviz_default_plugins/FPS
        Enable Stereo Rendering:
          Stereo Eye Separation: 0.05999999865889549
          Stereo Focal Distance: 1
          Swap Stereo Eyes: false
          Value: false
        Invert Z Axis: false
        Name: FPS
        Near Clip Distance: 0.009999999776482582
        Pitch: 0.5
        Position:
          X: -10
