<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>wbmm_robot</name>
  <version>0.1.0</version>
  <description>
    Reusable WBMM mobile-manipulator robot utilities: Pinocchio RobotModel adapter,
    whole-body kinematics correction, Eigen/core conversions, and ROS/core message
    conversions. No force-control policy lives here.
  </description>
  <maintainer email="user@todo.todo">WBMM</maintainer>
  <license>BSD-3-Clause</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>eigen</depend>
  <depend>pinocchio</depend>
  <depend>wbmm_core</depend>
  <depend>geometry_msgs</depend>
  <depend>ocs2_msgs</depend>
  <depend>std_msgs</depend>

  <test_depend>ament_cmake_gtest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
