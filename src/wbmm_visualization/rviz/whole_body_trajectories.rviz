Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Class: ''
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Ground grid
      Enabled: true
      Cell Size: 1
      Plane Cell Count: 20
      Color: 110; 120; 130
      Alpha: 0.35
      Reference Frame: <Fixed Frame>
    - Class: rviz_default_plugins/MarkerArray
      Name: Planner robot trajectory
      Enabled: true
      Topic:
        Value: /wbmm/visualization/planner
        Reliability Policy: Reliable
        Durability Policy: Transient Local
        History Policy: Keep Last
        Depth: 1
      Queue Size: 10
    - Class: rviz_default_plugins/MarkerArray
      Name: MPC predicted robot trajectory
      Enabled: true
      Topic:
        Value: /wbmm/visualization/mpc
        Reliability Policy: Reliable
        Durability Policy: Transient Local
        History Policy: Keep Last
        Depth: 1
      Queue Size: 10
  Enabled: true
  Global Options:
    Background Color: 32; 38; 46
    Fixed Frame: map
    Frame Rate: 30
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 6
      Focal Point: {X: 1.2, Y: 0.5, Z: 0.4}
      Pitch: 0.65
      Yaw: 0.85
      Name: Current View
      Near Clip Distance: 0.01
Window Geometry:
  Width: 1600
  Height: 900
  QMainWindow State: "000000ff00000000fd0000000100000000000001f700000296fc0200000001fb000000100044006900730070006c006100790073010000003d00000296000000c900ffffff0000036e0000029600000004000000040000000800000008fc0000000100000002000000010000000a0054006f006f006c00730100000000ffffffff0000000000000000"
