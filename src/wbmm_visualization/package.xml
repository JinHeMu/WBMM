<?xml version="1.0"?>
<package format="3">
  <name>wbmm_visualization</name>
  <version>0.1.0</version>
  <description>Display-only whole-robot trajectory ghosts for WBMM planner and MPC policies.</description>
  <maintainer email="user@todo.todo">WBMM</maintainer>
  <license>BSD-3-Clause</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>rclcpp</depend>
  <depend>eigen</depend>
  <depend>wbmm_core</depend>
  <depend>wbmm_robot_model</depend>
  <depend>wbmm_pinocchio</depend>
  <depend>wbmm_planner_ros</depend>
  <depend>ocs2_msgs</depend>
  <depend>visualization_msgs</depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <test_depend>ament_cmake_gtest</test_depend>
  <export><build_type>ament_cmake</build_type></export>
</package>
