<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>wbmm_ocs2</name>
  <version>0.1.0</version>
  <description>
    WBMM-owned OCS2 optimal control problem definition for the wheel-based
    mobile manipulator. This package deliberately implements only the 9-state /
    8-input differential-drive + 6-DoF-arm model agreed in docs/math_contract.md.
  </description>
  <maintainer email="user@todo.todo">WBMM</maintainer>
  <license>BSD-3-Clause</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>ocs2_ddp</depend>
  <depend>ocs2_sqp</depend>
  <depend>ocs2_self_collision</depend>

  <test_depend>ament_cmake_gtest</test_depend>
  <test_depend>ament_index_cpp</test_depend>
  <test_depend>tracer_jaka_description</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
